# Los puntos de entrada con shebang (#!/usr/bin/env node) y los wrappers .sh
# deben mantener LF incluso si el paquete de npm se empaqueta desde Windows:
# un CRLF en la primera línea rompe la ejecución en Linux y macOS con
# "/usr/bin/env: 'node\r': No such file or directory".
* text=auto eol=lf
*.cmd text eol=crlf
